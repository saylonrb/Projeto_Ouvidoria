# ────────────────────────────────────────────────
# Ouvidoria Municipal Inteligente — Variáveis de Ambiente
# Copie para .env e preencha com seus valores reais
# ────────────────────────────────────────────────

# ── Ambiente ───────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Banco de Dados (SQLite — automático) ───────
# O Prisma usa SQLite por padrão (prisma/dev.db).
# Para migrar para PostgreSQL em produção, altere
# o provider no schema.prisma e defina:
# DATABASE_URL=postgresql://user:password@host:5432/ouvidoria_db

# ── JWT (OBRIGATÓRIOS em produção) ─────────────
# Em desenvolvimento, secrets são gerados automaticamente.
# Em produção, o servidor NÃO inicia sem eles.
JWT_ACCESS_SECRET=mude_para_um_secret_forte_de_64_chars_minimo
JWT_REFRESH_SECRET=outro_secret_forte_diferente_de_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth 2.0 ──────────────────────────
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# ── Gemini AI (Google) ─────────────────────────
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ── Deduplicação IA ────────────────────────────
DEDUP_RADIUS_METERS=500
DEDUP_TIME_WINDOW_HOURS=72
DEDUP_SIMILARITY_THRESHOLD=0.75

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTH=300
